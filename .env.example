# ============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env)
# Scraper IRIS / Claro / Movistar / Personal / Datuar
# ============================================================================

# Credenciales de Acceso IRIS (Movistar BPM)
IRIS_USER=tu_usuario_iris
IRIS_PASS=tu_password_iris
IRIS_LOGIN_URL=http://iris.tmoviles.com.ar/workspace/faces/jsf/security/login.xhtml
HEADLESS=True
DELAY_MIN=1.5
DELAY_MAX=3.5

# VPS MySQL Central Queue (Cola Transaccional con FOR UPDATE SKIP LOCKED)
VPS_DBHOST=172.16.20.15
VPS_DBPORT=3306
VPS_DBUSER=tu_usuario_db
VPS_DBPASS=tu_password_db
VPS_DBNAME=bases
VPS_DB_TABLE=queue_registro_no_llame

# Tor Stream Isolation & Proxies (Opcional, defaults calculados automáticamente)
# TOR_ENABLED=True
# TOR_STREAM_ISOLATION=True
# TOR_PATH=C:\ruta\a\tor.exe
# TOR_SOCKS_PORT=9050
# TOR_CONTROL_PORT=9051
